{
  "trading_config": {
    "symbol": "BTCUSD",
    "timeframe": "M1",
    "model": "phi3:latest",
    "host": "localhost",
    "port": 11434,

    "alligator_parameters": {
      "jaw_period": 21,
      "jaw_shift": 8,
      "teeth_period": 13,
      "teeth_shift": 5,
      "lips_period": 8,
      "lips_shift": 3
    },

    "risk_management": {
      "sl_points": 1000,
      "tp_points": 2000,
      "max_risk_percent": 1.5,
      "max_lot_size": 0.05,
      "min_volatility_threshold": 0.001,
      "max_spread_percentage": 0.1
    },

    "performance_settings": {
      "cache_ttl": 30,
      "max_cache_size": 100,
      "cleanup_interval": 100,
      "request_timeout": 15
    },

    "logging": {
      "level": "INFO",
      "file": "ai_btcusd_trading_optimized.log"
    }
  },

  "optimization_settings": {
    "enable_caching": true,
    "enable_performance_monitoring": true,
    "enable_memory_cleanup": true,
    "max_execution_time": 30,
    "retry_attempts": 3
  },

  "btc_specific": {
    "volatility_thresholds": {
      "low": 0.005,
      "medium": 0.01,
      "high": 0.02
    },
    "risk_adjustments": {
      "low_volatility_risk_multiplier": 1.0,
      "medium_volatility_risk_multiplier": 0.75,
      "high_volatility_risk_multiplier": 0.5
    }
  }
}